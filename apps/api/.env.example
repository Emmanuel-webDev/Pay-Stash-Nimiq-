PORT=8787
WEB_ORIGIN=http://localhost:5173

# REQUIRED for /api/goals routes and `npm run migrate` — a real Postgres
# connection string. Supabase: Project Settings > Database > Connection
# string (URI, "Transaction" pooler mode is fine for this app's usage).
# NOTE: the direct-connection host (db.<ref>.supabase.co) is IPv6-only. On
# an IPv4-only network use the pooler host instead, e.g.:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Set to "false" only for a local Postgres without TLS configured (e.g.
# plain Docker). Supabase requires TLS — leave this unset for Supabase.
PGSSL=

# JSON-RPC endpoint used to independently verify Pay & Stash/Catch-up
# transactions server-side (apps/api/src/nimiqRpc.ts). Defaults to a public
# TestAlbatross RPC (from nimiq/awesome's "Testnet Open RPC Servers" list) —
# fine for hackathon/testnet use, not guaranteed production infrastructure.
# Self-hosting a replacement requires `full` or `history` sync mode; `light`
# mode does not support getTransactionByHash/getTransactionsByAddress.
NIMIQ_RPC_URL=
