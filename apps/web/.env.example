VITE_API_BASE_URL=http://localhost:8787

# Drives the small TESTNET label next to the wallet chip in the top bar
# (Shell.tsx) — anything other than exactly "mainnet" shows it. Set to
# "mainnet" on a mainnet build to make it disappear; unset defaults to
# showing it, matching this project's current testnet-only state.
VITE_NIMIQ_NETWORK=testnet
